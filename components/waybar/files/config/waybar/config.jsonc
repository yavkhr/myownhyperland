{
  "layer": "top",
  "position": "top",
  "height": 44,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,
  "modules-left": ["custom/power", "custom/reboot", "custom/lock", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/gpu-temp", "custom/sep-gpu-cpu", "custom/cpu-temp", "custom/sep-cpu-ram", "custom/memory", "custom/language", "custom/vpn", "pulseaudio"],
  "custom/power": {"format": "\uf011", "tooltip": true, "tooltip-text": "Выключить компьютер", "on-click": "systemctl poweroff"},
  "custom/reboot": {"format": "\uf021", "tooltip": true, "tooltip-text": "Перезагрузить компьютер", "on-click": "systemctl reboot"},
  "custom/lock": {"format": "\uf023", "tooltip": true, "tooltip-text": "Заблокировать экран", "on-click": "sh $HOME/.local/bin/lock-hyprland"},
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "default": "○",
      "empty": "○",
      "active": "●",
      "focused": "●",
      "urgent": "!"
    },
    "persistent-workspaces": { "*": 5 },
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "custom/language": {"exec": "$HOME/.local/bin/waybar-language", "interval": 0.2, "format": "\uf11c {}", "on-click": "$HOME/.local/bin/waybar-language-menu", "tooltip": true, "tooltip-text": "Выбрать язык"},
  "clock": {
    "format": "{:%A   %H:%M}",
    "format-alt": "{:%d %B %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "interval": 1,
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  },
  "custom/vpn": {"exec": "$HOME/.local/bin/waybar-vpn", "return-type": "json", "interval": 5, "on-click": "$HOME/.local/bin/hyprwat-wifi", "tooltip": true},
  "pulseaudio": {"format": "\uf028 {volume}%", "format-muted": "\uf026 muted", "on-click": "$HOME/.local/bin/waybar-audio-menu", "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle", "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+", "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-", "tooltip": true},
  "custom/gpu-temp": {"exec": "$HOME/.local/bin/waybar-gpu-temp", "format": "\uf2c7 GPU {}°C", "interval": 5, "tooltip": true},
  "custom/sep-gpu-cpu": {"format": "|"},
  "custom/cpu-temp": {"exec": "$HOME/.local/bin/waybar-cpu-temp", "format": "\uf2c7 CPU {}°C", "interval": 5, "tooltip": true},
  "custom/sep-cpu-ram": {"format": "|"},
  "custom/memory": {"exec": "$HOME/.local/bin/waybar-memory", "format": "\uf538 {}", "interval": 3, "tooltip": true}
}
