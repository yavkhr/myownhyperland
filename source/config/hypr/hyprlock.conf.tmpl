background {
    monitor =
    path = screenshot
    color = rgba(15, 18, 27, 1.0)
    blur_passes = 2
    blur_size = 6
}

animations {
    enabled = false
}

image {
    monitor =
    path = __HOME__/Pictures/my_ava.jpg
    size = 170
    rounding = -1
    border_size = 3
    border_color = rgba(120, 215, 255, 0.9)
    position = 0, 95
    halign = center
    valign = center
}

label {
    monitor =
    text = $USER
    color = rgba(220, 231, 245, 1.0)
    font_size = 24
    font_family = JetBrainsMono Nerd Font
    position = 0, -25
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 420, 72
    outline_thickness = 3
    rounding = 18
    dots_size = 0.25
    dots_spacing = 0.25
    dots_center = true
    outer_color = rgba(120, 215, 255, 0.9)
    inner_color = rgba(31, 40, 55, 0.95)
    font_color = rgba(220, 231, 245, 1.0)
    font_family = JetBrainsMono Nerd Font
    fade_on_empty = false
    hide_input = false
    placeholder_text = Password...
    check_color = rgba(120, 215, 255, 0.9)
    check_text =
    fail_color = rgba(240, 70, 90, 1.0)
    fail_text = Лох
    fail_timeout = 500
    fail_transition = 0
    position = 0, -125
    halign = center
    valign = center
}
