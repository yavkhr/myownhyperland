#!/bin/sh
wifi=$(nmcli -t -f TYPE,NAME connection show --active 2>/dev/null | awk -F: '$1 == "802-11-wireless" {print $2; exit}')
if [ -n "$wifi" ]; then
    printf '{"text":"󰖩","tooltip":"Wi‑Fi: %s"}\n' "$wifi"
else
    printf '{"text":"󰖪","class":"disconnected","tooltip":"Wi‑Fi не подключён"}\n'
fi
