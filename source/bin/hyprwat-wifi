#!/bin/sh
# Меню Wi-Fi без задержки.
# hyprwat при старте сам запрашивает сканирование сетей и ждёт его окончания
# (обычно 3-6 секунд) — из-за этого меню появляется не сразу.
# Здесь сканирование запускается в фоне ДО запуска hyprwat: NetworkManager
# отклоняет второй запрос (scan throttle), hyprwat сразу рисует уже
# закэшированный список сетей, а свежие результаты подхватывает по сигналам.
#
# ВАЖНО: waybar запускает команды с PATH=/usr/local/bin:/usr/bin, где нет
# ~/.local/bin, поэтому все пути здесь абсолютные.
/usr/bin/nmcli dev wifi rescan >/dev/null 2>&1 &

exec $HOME/.local/bin/hyprwat --wifi
